# ---------------------------------------------------------------------------
# Google Sheet product feed (optional)
#
# Feeds the "sheet preview" section in components/SheetProducts.tsx. With none
# of these set, that section renders the demo rows in content/sheet-demo.csv.
#
# How it works: the sheet link below is baked in at build time, but the rows are
# read by the visitor's browser on every page load. Edit a price, a colour or a
# photo in the sheet and refresh the page — no rebuild, no deploy.
#
# To use your own sheet:
#   1. Open the sheet, make sure the first row is the header row.
#   2. File > Share > Publish to web > CSV (or just share it as "anyone with the link").
#   3. Paste the link below. An edit link, a share link, a bare id or a ready
#      CSV link all work — the section converts it to a CSV endpoint itself.
#
# Header columns (order does not matter, names do):
#   required: slug, brand, name, tagline, stock, ram, storage, price,
#             colour, hex
#   optional: mrp, available, family, colour_available, image
#
# `stock`            in_stock | low_stock | on_order
# `available`        variant is stocked        (TRUE / FALSE, or a checkbox column)
# `colour_available` the colour is stocked     (TRUE / FALSE)
# `hex`              six-digit colour like #3C5FA8 — the fallback artwork
# `image`            optional photo for that colour. A full https URL
#                    (Cloudinary, R2, any host) or a site path like
#                    /images/phones/iphone-16-ultramarine.jpg. Blank keeps the
#                    drawn phone in that colour. One row per colour × variant,
#                    so each swatch can show its own photo.
# ---------------------------------------------------------------------------

# Option 1 — any sheet link (takes priority if both are set)
SHEET_CSV_URL=

# Option 2 — sheet id from docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
SHEET_TAB=Products
